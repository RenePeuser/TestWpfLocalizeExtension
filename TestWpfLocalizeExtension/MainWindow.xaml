<Window x:Class="TestWpfLocalizeExtension.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"        
        lex:LocalizeDictionary.DesignCulture="ru"
        lex:LocalizeDictionary.IncludeInvariantCulture="False"
        lex:ResxLocalizationProvider.DefaultAssembly="TestWpfLocalizeExtension"
        lex:ResxLocalizationProvider.DefaultDictionary="Ressourcen"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Label Content="{lex:Loc From}" HorizontalAlignment="Left" Height="56" Margin="83,66,0,0" VerticalAlignment="Top" Width="282"/>
        <Button Content="{lex:Loc From}" HorizontalAlignment="Left" Height="67" Margin="83,135,0,0" VerticalAlignment="Top" Width="270"/>

    </Grid>
</Window>
